{
  "name": "Retro98",
  "author": "Retro98",
  "globals": {
    "background": "#FFFFFF",
    "foreground": "#000000",
    "caret": "#000000",
    "selection": "#000080",
    "selection_foreground": "#FFFFFF",
    "inactive_selection": "#C0C0C0",
    "line_highlight": "#FFFFFF",
    "gutter": "#C0C0C0",
    "gutter_foreground": "#000000",
    "accent": "#000080",
    "misspelling": "#FF0000",
    "find_highlight": "#FFFF00",
    "find_highlight_foreground": "#000000",
    "guide": "#C0C0C0",
    "active_guide": "#808080",
    "brackets_options": "underline",
    "brackets_foreground": "#000080"
  },
  "rules": [
    { "name": "Comment", "scope": "comment, punctuation.definition.comment", "foreground": "#008000" },
    { "name": "String", "scope": "string", "foreground": "#800000" },
    { "name": "Number and constant", "scope": "constant.numeric, constant.language, constant.character", "foreground": "#800080" },
    { "name": "Keyword", "scope": "keyword, storage", "foreground": "#0000FF" },
    { "name": "Tag", "scope": "entity.name.tag, meta.tag punctuation.definition.tag", "foreground": "#000080" },
    { "name": "Attribute", "scope": "entity.other.attribute-name", "foreground": "#008080" },
    { "name": "Library", "scope": "support, entity.other.inherited-class", "foreground": "#008080" },
    { "name": "Definition", "scope": "entity.name.function, entity.name.class, entity.name.type", "foreground": "#000000", "font_style": "bold" },
    { "name": "Invalid", "scope": "invalid", "foreground": "#FFFFFF", "background": "#FF0000" },
    { "name": "Heading", "scope": "markup.heading", "foreground": "#000080", "font_style": "bold" },
    { "name": "Bold", "scope": "markup.bold", "font_style": "bold" },
    { "name": "Italic", "scope": "markup.italic", "font_style": "italic" },
    { "name": "Inserted", "scope": "markup.inserted", "foreground": "#008000" },
    { "name": "Deleted", "scope": "markup.deleted", "foreground": "#800000" },
    { "name": "Changed", "scope": "markup.changed", "foreground": "#800080" }
  ]
}
